<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="input_odometry" default="/localization/kinematic_state"/>
  <arg name="input_acceleration" default="/localization/acceleration"/>
  <arg name="input_route" default="/planning/mission_planning/route"/>
  <arg name="input_vector_map" default="/map/vector_map"/>
  <arg name="output_trajectory" default="/planning/trajectory/manual"/>
  <arg name="vehicle_model" default="medium_bus"/>
  <arg name="vehicle_param_file_path" default="$(find-pkg-share $(var vehicle_model)_description)/config/vehicle_info.param.yaml"/>
  <arg name="common_param" default="$(find-pkg-share autoware_launch)/config/planning/scenario_planning/common/common.param.yaml"/>

  <node pkg="autoware_manual_trajectory" exec="manual_trajectory" name="manual_trajectory" launch-prefix="konsole --separate --hold -e gdb -ex run --args">
    <param from="$(var common_param)"/>
    <param from="$(var vehicle_param_file_path)"/>
    <remap from="~/input/odometry" to="$(var input_odometry)"/>
    <remap from="~/input/accel" to="$(var input_acceleration)"/>
    <remap from="~/input/route" to="$(var input_route)"/>
    <remap from="~/input/vector_map" to="$(var input_vector_map)"/>
    <remap from="~/output/trajectory" to="$(var output_trajectory)"/>
  </node>
</launch>
